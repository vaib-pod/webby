# Copy to backend/.env. It loads automatically; shell variables override it.
# Keep all real keys out of extension files and source control.
# Groq and xAI/Grok are different providers. An xai- key belongs to xAI.
SUMMARY_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
XAI_API_KEY=
XAI_MODEL=grok-4.3
# Legacy OpenAI support remains available with SUMMARY_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GNANI_API_KEY=
GNANI_MODEL=timbre-v2.5
GNANI_VOICE=Kaveri
GNANI_LANGUAGE=en-IN
PORT=3001
